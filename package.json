{
  "name": "premiere-mcp-bridge",
  "version": "0.4.4",
  "private": true,
  "description": "An extensible local MCP bridge between AI agents and Adobe Premiere Pro UXP",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test --test-concurrency=2 tests/*.test.cjs",
    "setup": "npm run build && node scripts/setup.mjs",
    "onboard": "npm run build && node scripts/onboard.mjs",
    "doctor": "node scripts/doctor.mjs",
    "release:assets": "npm run build && node scripts/prepare-release-assets.mjs",
    "mcp:prepare": "node mcp/server.mjs --prepare",
    "mcp:start": "node mcp/server.mjs",
    "mcp:smoke": "node mcp/smoke.mjs",
    "plugin:load": "node scripts/load-plugin.mjs",
    "docs:sync": "node scripts/sync-adobe-api.mjs",
    "manual:sync": "node scripts/sync-premiere-manual.mjs",
    "api:matrix": "npm run build && node scripts/api-coverage-matrix.mjs",
    "test:prepare-live": "node scripts/prepare-live-verification.mjs"
  },
  "devDependencies": {
    "@adobe/premierepro": "26.5.0",
    "@modelcontextprotocol/client": "2.4.0",
    "esbuild": "0.25.5",
    "typescript": "5.8.3",
    "yazl": "3.3.1"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "parse5": "8.0.1",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "license": "MIT",
  "bin": {
    "premiere-mcp-bridge": "mcp/server.mjs"
  },
  "files": [
    "src/",
    "assets/",
    "dist/main.js",
    "build/lib/",
    "mcp/",
    "scripts/",
    "docs/",
    ".github/ISSUE_TEMPLATE/",
    ".github/pull_request_template.md",
    "examples/",
    "tests/",
    "manifest.json",
    "updates.json",
    "index.html",
    "styles.css",
    "tsconfig.json",
    "AGENTS.md",
    "INSTALL.md",
    "INDEX.md",
    "OPEN_SOURCE.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "data/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ywdagency/premiere-mcp-bridge.git"
  },
  "homepage": "https://github.com/ywdagency/premiere-mcp-bridge#readme",
  "bugs": {
    "url": "https://github.com/ywdagency/premiere-mcp-bridge/issues"
  }
}
