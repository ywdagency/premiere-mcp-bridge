{
  "manifestVersion": 5,
  "id": "com.yeswelldone.premiere-auto-editor",
  "name": "Premiere MCP Bridge",
  "version": "0.3.8",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "command",
      "id": "connectReadOnlyMcp",
      "label": "Launch"
    },
    {
      "type": "command",
      "id": "disconnectReadOnlyMcp",
      "label": "Stop"
    },
    {
      "type": "command",
      "id": "reloadBridge",
      "label": "Reload"
    },
    {
      "type": "panel",
      "id": "premiereAutoEditorPanel",
      "label": {
        "default": "Premiere MCP Bridge"
      },
      "minimumSize": {
        "width": 320,
        "height": 152
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 200
      },
      "preferredFloatingSize": {
        "width": 360,
        "height": 200
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": { "domains": ["https://raw.githubusercontent.com"] },
    "launchProcess": { "schemes": ["https"] }
  }
}
